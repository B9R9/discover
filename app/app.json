{
  "expo": {
    "name": "Détour",
    "slug": "discover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "discover",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.b9r9.dtour",
      "adaptiveIcon": {
        "backgroundColor": "#2A2630",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED"]
    },
    "ios": {
      "bundleIdentifier": "com.b9r9.dtour"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A2630",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Détour utilise l'appareil photo pour découvrir un lieu : prends-le en photo sur place. Tes photos restent sur ton téléphone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withSingleTopActivity",
      "./plugins/withReleaseSigning",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Détour utilise ta position pour dévoiler la carte autour de toi et t'indiquer la direction des lieux. Elle reste sur ton téléphone.",
          "locationAlwaysAndWhenInUsePermission": "Avec « Toujours », Détour dévoile les rues que tu parcours même écran éteint. Tes trajets restent sur ton téléphone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
