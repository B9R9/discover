# Les variables lues par l'app doivent commencer par EXPO_PUBLIC_ (elles sont incluses dans le bundle).
# Clé OpenRouteService (itinéraire à pied), dédiée à l'app : https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_KEY=
# API Détour. En dev sur le téléphone : http://localhost:3000 avec `adb reverse tcp:3000 tcp:3000`.
EXPO_PUBLIC_API_URL=http://localhost:3000
